# FasalRakshak - Environment Variables Template
# Copy this file to .env and insert your real API keys before running the application.

# Google Gemini API Key (Required for AgroBot conversational assistant in chat advisory)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (Optional - provides human-quality regional Indian neural voice announcements)
# If omitted or left empty, the application automatically falls back to offline gTTS.
SARVAM_API_KEY=your_sarvam_api_key_here
